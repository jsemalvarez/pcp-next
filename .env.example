# Plantilla de variables de entorno. Copiala según el entorno:
#   .env.dev   → desarrollo local (lo usan npm run dev y los scripts db:*)
#   .env.prod  → credenciales de producción, solo para npm run db:pull-prod
# En Vercel las variables se cargan desde el dashboard; ahí no se usan estos archivos.
# Ningún .env.* (salvo este) se sube al repo.

######## CLOUDINARY
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

######## BASE DE DATOS
# Contenedor local (docker-compose). En .env.prod no hacen falta.
POSTGRES_USER=pcp
POSTGRES_PASSWORD=pcp
POSTGRES_DB=pcp

# Local:      postgresql://pcp:pcp@localhost:5433/pcp (las dos iguales)
# Producción: DATABASE_URL = pooler de Supabase en modo transacción (puerto 6543)
#             DIRECT_URL   = pooler en modo sesión (puerto 5432); lo usan las migraciones y el backup
DATABASE_URL="postgresql://pcp:pcp@localhost:5433/pcp"
DIRECT_URL="postgresql://pcp:pcp@localhost:5433/pcp"

######## AUTH
# Clave para firmar la sesión del admin. Generar una distinta por entorno, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=""

# Admin que crea el seed (npm run db:seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
